# Arc TESTNET preset (chain 5042002). Unlike Arc mainnet, this is publicly
# open — verified working 2026-07-31, when a 9,000-block scan found 197 pool
# creations, all quoting native USDC.
#
# Its value is as a rehearsal rig: mainnet is gated, so this is the only way to
# exercise the Arc code path end to end. Factory addresses will differ at
# mainnet, but everything here is env-driven, so switching is a config edit.

DISCOVERY_SOURCE=rpc
ARC_RPC_URLS=https://rpc.testnet.arc.io

# Testnet's explorer was not reachable during setup, so this points at the
# mainnet Blockscout purely so alert links render. Verification lookups will
# fail closed (verified = unknown), which never gates an alert on its own.
BLOCKSCOUT_BASE_URL=https://arc-mainnet.cloud.blockscout.com

# Native USDC — the gas token, and the quote side of all 197 sampled pools.
# Resolved on-chain at boot as USDC/6dp.
QUOTE_TOKENS=0x3600000000000000000000000000000000000000

# Dominant V3 factory, 226 of 227 pools in a 10k-block sample.
V3_FACTORIES=0xba27c71bf06ab69723d9bd7c96f13d591fd53a93
# No V2 factory observed on testnet; this placeholder keeps the V2 scan inert.
V2_FACTORIES=0x0000000000000000000000000000000000000001

# This RPC hard-errors above a 10,000-block range (-32614), unlike Robinhood
# Chain's, which served 20k happily.
DISCOVERY_CHUNK_BLOCKS=9000

# Most testnet pools are created and never funded, so a realistic floor filters
# essentially everything. Drop to 0 if you want to watch the full firehose.
MIN_LIQUIDITY_QUOTE=1

ALERT_RECENCY_BLOCKS=7200
QUALITY_WINDOW_BLOCKS=500
DRY_RUN_ALERTS=true
DB_PATH=./data/arc-testnet.db
