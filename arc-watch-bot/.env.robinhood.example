# Robinhood Chain preset. Verified live on 2026-07-31: the engine resolved WETH
# (18dp) and USDG (6dp) on-chain, scanned 4,010 blocks, and found 91 launches.
#
# Copy to .env to run against this chain instead of Arc.

DISCOVERY_SOURCE=rpc
ARC_RPC_URLS=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_BASE_URL=https://robinhoodchain.blockscout.com

# WETH quotes 289 of 296 sampled pools here; USDG is a distant second.
QUOTE_TOKENS=0x0bd7d308f8e1639fab988df18a8011f41eacad73,0x5fc5360d0400a0fd4f2af552add042d716f1d168

# Discovered by scanning 20k blocks of factory events on 2026-07-31.
# V3 is the verified UniswapV3Factory and carries ~60% of new pools.
V3_FACTORIES=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
V2_FACTORIES=0x0d1ebb179cdbca88d74c923c4255cb2b17474afd,0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f,0xfc2e4da3edb2e18100473339c763705d263d20a9

# Denominated in WETH, NOT dollars. Chosen from the measured distribution:
# this chain produces ~18,700 launches/day, and even an 8 WETH floor still
# leaves ~400 alerts/day. Liquidity alone cannot make this channel-ready —
# see the README note on porting the honeypot/bundle gates.
MIN_LIQUIDITY_QUOTE=5

# ~35,640 blocks ≈ 1 hour at this chain's 101ms blocks (Arc's 7200 default is
# tuned for 505ms blocks and would mean only ~12 minutes here).
ALERT_RECENCY_BLOCKS=35640

# The RPC served 20k-block eth_getLogs ranges without complaint.
DISCOVERY_CHUNK_BLOCKS=20000

DRY_RUN_ALERTS=true
DB_PATH=./data/robinhood-watch.db

# Quality gates (measured live 2026-07-31: blocked 2 of 3 launches that cleared
# the liquidity floor, including the highest-liquidity one at 71% bundled).
QUALITY_WINDOW_BLOCKS=500
BUNDLE_MAX_TOP5_PCT=60
HONEYPOT_MIN_BUYERS=15
