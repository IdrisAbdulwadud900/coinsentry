# Telegram (required only when DRY_RUN_ALERTS=false)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alerts are dry-run (logged, not sent) until explicitly enabled
DRY_RUN_ALERTS=true

# Chain access — defaults are Arc mainnet's public endpoints
#ARC_RPC_URLS=https://rpc.blockdaemon.mainnet.arc.io,https://arc-mainnet.cloud.blockscout.com/api/eth-rpc
#BLOCKSCOUT_BASE_URL=https://arc-mainnet.cloud.blockscout.com

# Factories to watch (defaults discovered on-chain 2026-07-30; see src/config.ts)
#V2_FACTORIES=0xdfef2f90f7e52609cc89b80b68ff6a1c86c4ddc4,0x942bd5bfdc5317c5507e326f8eb4bb6058ab5c10
#V3_FACTORIES=0xf0db7b58379503491d857db50ac9ece64c653918

# Discovery backend. Arc's public RPC rejects eth_getLogs, so Blockscout is the
# only way in here; most other chains should use "rpc".
#DISCOVERY_SOURCE=blockscout

# Quote assets a pool must pair against. Arc's is native USDC (6dp), which is
# also its gas token. Decimals are read on-chain at boot, never configured.
#QUOTE_TOKENS=0x3600000000000000000000000000000000000000

# Alert gates. MIN_LIQUIDITY_QUOTE is denominated in whole units of the quote
# asset above — on Arc that means USDC, so 1000 really is ~$1000.
#MIN_LIQUIDITY_QUOTE=1000
#SPAM_DEPLOYER_THRESHOLD=10

# Quality gates: observe this many blocks after launch (~4min at Arc's 505ms),
# then block on bundle concentration or missing sell evidence.
#QUALITY_WINDOW_BLOCKS=500
#BUNDLE_MAX_TOP5_PCT=60
#HONEYPOT_MIN_BUYERS=15
# Only launches within this many blocks of the head are alertable (~1h at 505ms
# blocks). Older ones are recorded silently, so a backlog never floods a channel.
#ALERT_RECENCY_BLOCKS=7200

#POLL_INTERVAL_SECONDS=15
# Cadence of the cheap access probe used while Arc's public endpoints are shut
#ACCESS_PROBE_INTERVAL_SECONDS=300
#DISCOVERY_START_BLOCK=12600000
#LOG_LEVEL=info
#DB_PATH=./data/arc-watch.db
