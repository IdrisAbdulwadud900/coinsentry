{
  "name": "coinsentry",
  "version": "1.0.0",
  "description": "Telegram bot that monitors crypto tokens on any chain via DexScreener and alerts on price/mcap/liquidity/trend conditions",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.0.1",
    "@grammyjs/menu": "^1.3.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.32.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
