# ─────────────────────────────────────────────────────────────
#  REQUIRED
# ─────────────────────────────────────────────────────────────

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat IDs allowed to use the bot.
# Leave empty to let anyone use it (fine for a private bot nobody knows about,
# but every scan spends provider credits, so an allowlist is recommended).
ALLOWED_CHAT_IDS=

# ─────────────────────────────────────────────────────────────
#  SOLANA DATA PROVIDERS
#  Without at least one of these, Solana tokens cannot be analyzed.
#  EVM chains work with no keys at all.
# ─────────────────────────────────────────────────────────────

# https://dashboard.helius.dev — free tier is 1M credits/month.
# This is the important one: it returns raw parsed transactions, which is what
# powers the supply-relay and dev-cluster analysis. Nothing else can do those.
HELIUS_API_KEY=

# https://www.solanatracker.io/data-api — free tier is 10k requests/month.
# Optional. Supplies precomputed first-buyers, which covers wallets that fall
# outside the replayed window on very heavily traded tokens.
SOLANATRACKER_API_KEY=

# Public Solana RPC. Only used as a fallback; Helius provides its own.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─────────────────────────────────────────────────────────────
#  EVM RPCs (optional — built-in keyless defaults are used when blank)
# ─────────────────────────────────────────────────────────────
#
# Defaults, verified live 2026-08-11:
#   ethereum  https://rpc.mevblocker.io   serves archive getLogs, 10k block spans
#   base      https://mainnet.base.org    serves archive getLogs
#   bsc       https://bsc-rpc.publicnode.com  RECENT BLOCKS ONLY
#
# No free BNB Chain endpoint serves archive log ranges — every one tested
# returns "Archive requests require a personal token". For BSC tokens older
# than the public retention window, set BSC_RPC_URL to a keyed archive endpoint
# (Alchemy, QuickNode, Ankr paid, etc.) or the launch window will be missed.
ETHEREUM_RPC_URL=
BSC_RPC_URL=
BASE_RPC_URL=

# Override the per-chain eth_getLogs span. 0 = use each chain's tuned default.
EVM_LOG_CHUNK_BLOCKS=0
# How many chunks to walk before reporting partial coverage.
EVM_MAX_LOG_CHUNKS=400

# ─────────────────────────────────────────────────────────────
#  ANALYSIS THRESHOLDS
# ─────────────────────────────────────────────────────────────

# Absolute "got in early" market cap ceiling.
EARLY_MCAP_USD=10000
# Floor band = [floorMcap, floorMcap * this]. Catches wallets that bought the
# actual bottom on a coin that never traded under EARLY_MCAP_USD.
FLOOR_BAND_MULT=1.75
# Multiples a wallet must have ridden before its first sell to rank as a
# diamond hand. The first value is also the minimum to appear at all.
DIAMOND_BUCKETS=3,4,5,10,25,50,100
# Minimum position, as a percentage of the coin's FLOOR market cap.
# This is the real filter, and it scales with the coin: 0.05% of a $9k floor is
# ~$5, while 0.05% of a $1.4M floor is ~$700. A flat dollar bar would either
# hide the early buyers on a micro-cap or drown a large-cap in dust.
MIN_POSITION_FLOOR_PCT=0.05
# Absolute sanity floor in USD, applied when the scaled value comes out lower.
# Stops a micro-cap launch surfacing cent-sized test buys.
MIN_POSITION_USD=5
# Sold/held ratio at which a position counts as fully exited.
FULL_EXIT_RATIO=0.95

# ─────────────────────────────────────────────────────────────
#  SUPPLY RELAY DETECTION
# ─────────────────────────────────────────────────────────────

# The receiving wallet must sell at least this share of what it was given.
RELAY_MIN_SINK_SELL_RATIO=0.5
# Ignore relays below this share of total supply.
RELAY_MIN_SUPPLY_PCT=0.05
# Selling within this many seconds of receiving reads as deliberate.
RELAY_FAST_SELL_SECONDS=10800

# ─────────────────────────────────────────────────────────────
#  DEV CLUSTER
# ─────────────────────────────────────────────────────────────

# Hops to walk outward from the dev wallet in the funding graph.
DEV_GRAPH_HOPS=2
# Max wallets expanded per hop. Guards free-tier credits.
DEV_GRAPH_FANOUT=25
# Buys within this many seconds of launch count as bundle co-buys.
BUNDLE_WINDOW_SECONDS=30

# ─────────────────────────────────────────────────────────────
#  BUDGET / PERFORMANCE
# ─────────────────────────────────────────────────────────────

# Hard ceiling on transactions HYDRATED for one token. This is the expensive
# budget: one request per 100 transactions, each returning full bodies.
MAX_TX_FETCH=25000

# How far back to LIST signatures. This is the cheap budget: 1000 signatures per
# request, no transaction bodies. It MUST be larger than MAX_TX_FETCH — Solana
# returns signatures newest-first, so a shared budget stops the walk mid-history
# and the oldest signature in hand gets mistaken for the token's launch, which
# reports a "floor" that is really just the low of a recent window.
MAX_SIGNATURE_SCAN=120000

# Ignore swaps below this USD value. Solana charges ~0.00204 SOL of rent to open
# a token account; when a swap event cannot be decoded, that rent looks exactly
# like payment, and a ~$0.16 "purchase" of a few tokens implies a market cap
# hundreds of times the real one.
MIN_TRADE_USD=1

# A wallet must hold at least this long before its run counts as conviction.
# Without it a same-block flipper inherits whatever spike happened around it.
DIAMOND_MIN_HOLD_SECONDS=60

# --- Price-outlier rejection -------------------------------------------------
# Trades are compared against the median price of their time-neighbours. A real
# price move is continuous; an isolated spike no neighbour agrees with is an
# artifact of trade reconstruction.
OUTLIER_WINDOW=25
OUTLIER_MIN_SAMPLES=20
# Max deviation from the local median for a normal-sized trade.
OUTLIER_DEVIATION=10
# Trades under this value are held to a tighter tolerance: they cannot have
# moved the market, so they cannot justify a price far from their neighbours.
OUTLIER_SMALL_TRADE_USD=5
OUTLIER_SMALL_DEVIATION=3

# Parallel in-flight provider requests.
FETCH_CONCURRENCY=4
# How long a completed report is reused before a re-scan refetches.
CACHE_TTL_SECONDS=900
# Per-user gap between scans.
USER_COOLDOWN_SECONDS=10
# Wallets shown per page in the leaderboards.
LEADERBOARD_PAGE_SIZE=8

LOG_LEVEL=info
