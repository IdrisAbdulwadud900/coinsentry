# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID to receive alerts
TELEGRAM_CHAT_ID=

# How often to poll DexScreener + run incremental on-chain discovery, in seconds
POLL_INTERVAL_SECONDS=300

# --- Dead classification thresholds (spec section 5) ---
DEAD_MIN_AGE_HOURS=24
DEAD_VOLUME_24H_USD=500
DEAD_MIN_BUYS_1H=3
DEAD_CONFIRM_POLLS=6

# --- Revival signal thresholds (spec section 6) ---
REVIVAL_VOLUME_MULTIPLE=8
REVIVAL_MIN_VOLUME_1H_USD=300
REVIVAL_MIN_BUYS_1H=5
REVIVAL_LIQUIDITY_FLOOR_PCT=0.8
REVIVAL_CONFIRM_POLLS=2
ALERT_COOLDOWN_HOURS=6

# Consecutive polls under threshold before demoting reviving/alerted back to dead
DEMOTE_CONFIRM_POLLS=3

# How long to keep snapshot rows before pruning
SNAPSHOT_RETENTION_DAYS=7

# --- Robinhood Chain / Pons on-chain discovery ---
# DexScreener's chainId slug for Robinhood Chain (verified live 2026-07-21)
ROBINHOOD_CHAIN_ID_DEXSCREENER=robinhood

# Chains to track (DexScreener chainId slugs). Robinhood is discovered from Pons factory
# events on-chain; the others come from DexScreener's cross-chain discovery feeds and are
# tracked market-data-only (no graduation / bundle % / dev-wallet / holder lines).
ENABLED_CHAINS=robinhood,solana,bsc,ethereum

# Public RPC for Robinhood Chain (chainId 4663), verified reachable 2026-07-21
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Pons factory contract addresses, from https://docs.ponsfamily.com/ (verified 2026-07-21)
PONS_FACTORY_ACTIVE=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB
PONS_FACTORY_ACTIVE_START_BLOCK=8991118
PONS_FACTORY_LEGACY=0x0c37a24F5D23A486FA692d1500881d698B1F77a4
PONS_FACTORY_LEGACY_START_BLOCK=8600612

# Max block range per eth_getLogs call. Verified live 2026-07-21: this RPC accepts
# ranges up to ~1,000,000 blocks (2,000,000 fails, likely a result-count cap), so
# 500,000 leaves comfortable margin while keeping the full backfill to ~28 calls.
DISCOVERY_CHUNK_BLOCKS=500000

# Minimum liquidity (USD) a newly discovered token must have on DexScreener to be
# tracked as 'active' right away. Below this (or not indexed yet), it's tracked as
# 'unindexed' and only rechecked occasionally, instead of every poll cycle.
DISCOVERY_MIN_LIQUIDITY_USD=200

# If a single deployer address has launched more than this many tokens, treat their
# new launches as likely spam: track as 'unindexed' immediately, skipping the
# DexScreener lookup entirely at discovery time.
SPAM_DEPLOYER_THRESHOLD=15

# How often (hours) to recheck 'unindexed' tokens in case they later got indexed
# and gained real liquidity, instead of checking every single poll cycle.
UNINDEXED_RECHECK_HOURS=24

# Max number of graduationStatus() calls batched into a single multicall3 request
# when rechecking ungraduated tokens' on-chain bonding/graduation progress each cycle.
GRADUATION_CHECK_BATCH_SIZE=300

# Max concurrent DexScreener batch requests in flight at once (each request covers up
# to 30 token addresses). This only affects latency-hiding, not raw throughput — see
# DEXSCREENER_REQUESTS_PER_MINUTE below, which is what actually paces request volume.
DEXSCREENER_CONCURRENCY=4

# Max DexScreener requests per minute across all concurrent workers combined (includes
# retries). DexScreener's pairs/tokens endpoints are documented at ~300 req/min; this
# stays comfortably under that to avoid sustained 429 rate-limit storms.
DEXSCREENER_REQUESTS_PER_MINUTE=250

# --- API server ---
# Port and host the built-in read-only JSON API server binds to.
PORT=8787
HOST=0.0.0.0

# Path to the SQLite database file
DB_PATH=./data/pons-revival.db

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# When true, revival alerts are logged to console instead of sent to Telegram.
# Keep this true until you've watched a few poll cycles and the thresholds feel right.
DRY_RUN_ALERTS=true

# --- Fast early-detection loop (runs independently of POLL_INTERVAL_SECONDS above) ---
# How often the fast loop runs discovery + ungraduated curve-progress tracking +
# early-momentum detection, in seconds. Kept short so brand-new tokens surface fast.
FAST_DISCOVERY_INTERVAL_SECONDS=20

# Recency window (hours) bounding both fast sweeps below, so their DB queries/RPC
# batches stay a constant size regardless of total historical token count.
UNGRADUATED_FAST_WINDOW_HOURS=6

# Comma-separated ascending USD tiers of real market cap that trigger a market-cap
# tier alert. Spans both pre- and post-graduation tokens: for ungraduated tokens the
# market cap is computed from the live on-chain Uniswap V3 pool price (see
# readPoolMarketCaps), for graduated/indexed tokens it comes from DexScreener's own
# marketCap/fdv fields. Never a fabricated or approximated figure.
# NOTE: entry alerts are hard-capped in code at $11,000 market cap (poller.ts,
# MAX_ALERT_MARKET_CAP_USD), so tiers above that can never fire.
MARKET_CAP_ALERT_TIERS_USD=3000,4000,5000,6000,10000

# A token only qualifies for the "early momentum" alert(s) while its age
# (since first_seen_at) is at or under this many minutes.
EARLY_MOMENTUM_MAX_AGE_MINUTES=60

# Minimum 5-minute buy count and 5-minute USD volume (both required) for a
# freshly-launched token to trigger the first early-momentum alert.
EARLY_MOMENTUM_MIN_BUYS_5M=10
EARLY_MOMENTUM_MIN_VOLUME_5M_USD=1000

# Allows at most one bounded follow-up momentum alert per token: fires again only if
# 5-minute buys/volume have grown to at least this multiple of the original thresholds
# above since the first momentum alert.
MOMENTUM_REALERT_MULTIPLE=3

# How often (seconds) to refresh the cached ETH/USD price used to convert on-chain
# pool prices (for ungraduated/pre-index tokens) into USD market cap figures.
ETH_USD_PRICE_REFRESH_SECONDS=60

# Ascending multiples-since-first-alert (current market cap / entry baseline market cap at
# the token's first alert) that trigger a "how many x's" performance milestone alert. Each
# multiple fires at most once per token, ever.
PERFORMANCE_MILESTONE_MULTIPLES=2,3,5,10,20,50,100,200,500,1000
